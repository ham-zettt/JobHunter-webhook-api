{"nodes": [{"id": "docs_decisions_d001", "label": "D-001 HTML parser backend: selectolax lexbor", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-001", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARCHITECTURE \u00a73 allows selectolax or bs4+lxml; selectolax.lexbor chosen because the `parser` backend is deprecated since selectolax 1.0, and it removes the lxml dependency.", "_origin": "semantic"}, {"id": "docs_decisions_d002", "label": "D-002 Schema created by app/db/schema.py, Alembic calls it", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-002", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth and safe on a fresh DB; the cost is that subsequent schema changes must still be written as explicit migrations.", "_origin": "semantic"}, {"id": "docs_decisions_d003", "label": "D-003 Location aliases read from YAML; location_aliases table only seeded", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-003", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the pipeline pure and testable without a DB; the normalizer must be changed if aliases later move to DB/API editing.", "_origin": "semantic"}, {"id": "docs_decisions_d004", "label": "D-004 `updated` counts only genuine detail re-fetches", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-004", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The known-listing path only touches last_seen_at, so a no-change second scrape reports new=0, updated=0 instead of updated=N.", "_origin": "semantic"}, {"id": "docs_decisions_d005", "label": "D-005 Keyword seeding at startup only when the table is empty", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-005", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "seed_keywords is idempotent and never overwrites source='user', so a user-deleted seed is not forced back; POST /keywords/reseed gives an explicit reset.", "_origin": "semantic"}, {"id": "docs_decisions_d006", "label": "D-006 Status endpoint accepts active|archived|expired", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-006", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FR-47 only names archived; active cancels archiving and expired matches the DB enum, avoiding a new endpoint.", "_origin": "semantic"}, {"id": "docs_decisions_d007", "label": "D-007 F3+ platform scrapers are still discovery stubs", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-007", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate: SCRAPER_SPEC forbids inventing selectors, so classes raise SiteChangedError (sub-run degraded) until real discovery is done.", "_origin": "semantic"}, {"id": "docs_decisions_d008", "label": "D-008 SSRF guard on callback_url", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-008", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "callback_url must be http/https; without CALLBACK_ALLOWED_HOSTS, private/loopback/link-local/reserved hosts (including DNS-resolved ones) are rejected, and with an allowlist only those hosts pass \u2014 the n8n host on the Docker network must be registered.", "_origin": "semantic"}, {"id": "docs_decisions_d009", "label": "D-009 EXPORT_MAX_ROWS env variable", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-009", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mentioned in ARCHITECTURE \u00a77.2 but missing from .env.example, so added as an env with default 50000.", "_origin": "semantic"}, {"id": "docs_decisions_d010", "label": "D-010 Internal scheduler not activated", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "D-010", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCHEDULE_CRON (FR-11, optional) is unimplemented because n8n is the primary scheduler.", "_origin": "semantic"}, {"id": "docs_decisions_app_db_schema", "label": "app/db/schema.py", "file_type": "code", "source_file": "docs/DECISIONS.md", "source_location": "D-002", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ensure_schema_sync() idempotently creates tables from metadata plus FTS5/trigger DDL.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_decisions_pipeline_location", "label": "pipeline/location.py", "file_type": "code", "source_file": "docs/DECISIONS.md", "source_location": "D-003", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loads config/locations_java.yaml directly so the pipeline stays pure and DB-free for testing.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_decisions_config_locations_java_yaml", "label": "config/locations_java.yaml", "file_type": "document", "source_file": "docs/DECISIONS.md", "source_location": "D-003", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_decisions_architecture", "label": "ARCHITECTURE document", "file_type": "document", "source_file": "docs/DECISIONS.md", "source_location": "header, D-001, D-004, D-007, D-009", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Precedence order is PRD > DATABASE > ARCHITECTURE > SCRAPER_SPEC, so deviations from ARCHITECTURE are recorded 